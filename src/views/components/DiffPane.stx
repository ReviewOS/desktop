<script server>
// The diff. Two gutters of line numbers and a marker column, which is the
// layout every review tool converged on because it answers "where in the old
// file" and "where in the new file" at the same time.
export const files = $props.files || []
export const isEmpty = files.length === 0
</script>

<div class="h-full">
  @if (isEmpty)
    <div class="flex h-full flex-col items-center justify-center gap-2 text-center">
      <span class="i-f7-doc-text h-7 w-7 opacity-20"></span>
      <p class="text-[13px] opacity-45">Select a file to see its changes.</p>
    </div>
  @else
    @foreach (files as file)
      <div class="border-b border-black/8 last:border-b-0 dark:border-white/8">
        <!--
          Sticky so the filename stays visible while scrolling a long diff —
          losing track of which file you are reading is the single most common
          complaint about long patches.
        -->
        <div class="sticky top-0 z-10 flex items-center gap-2 border-b border-black/8 bg-[#f2f0ec]/92 px-3 py-2 backdrop-blur-xl dark:border-white/8 dark:bg-[#1c1c1e]/92">
          <span class="i-f7-doc-text h-[15px] w-[15px] shrink-0 opacity-50"></span>
          <span class="min-w-0 flex-1 truncate font-mono text-[12px]">
            @if (file.oldPath)
              <span class="opacity-45">{{ file.oldPath }}</span>
              <span class="mx-1 opacity-35">→</span>
            @endif
            {{ file.path }}
          </span>
          <span class="shrink-0 font-mono text-[11px] text-[#34c759]">+{{ file.additions }}</span>
          <span class="shrink-0 font-mono text-[11px] text-[#ff383c]">−{{ file.deletions }}</span>
        </div>

        @if (file.binary)
          <p class="px-4 py-6 text-center text-[12px] opacity-45">Binary file not shown.</p>
        @elseif (file.hunks.length === 0)
          <p class="px-4 py-6 text-center text-[12px] opacity-45">
            @if (file.modeChange)
              Mode changed from {{ file.modeChange.from }} to {{ file.modeChange.to }}.
            @else
              No textual changes.
            @endif
          </p>
        @else
          <table class="w-full border-collapse font-mono text-[12px] leading-[18px]">
            @foreach (file.hunks as hunk)
              <tr>
                <td colspan="3" class="bg-[#0088ff]/8 px-3 py-1 text-[11px] text-[#0088ff]/80 select-all">{{ hunk.header }}</td>
              </tr>
              @foreach (hunk.lines as line)
                <tr class="{{ line.kind === 'add' ? 'bg-[#34c759]/12' : line.kind === 'delete' ? 'bg-[#ff383c]/12' : '' }}">
                  <!--
                    `user-select: none` on the gutters: without it, copying a
                    diff out of the pane takes the line numbers with it, which
                    is the reason pasted patches so often fail to apply.
                  -->
                  <td class="w-[52px] select-none border-r border-black/6 px-2 text-right align-top tabular-nums opacity-35 dark:border-white/8">{{ line.oldNumber ?? '' }}</td>
                  <td class="w-[52px] select-none border-r border-black/6 px-2 text-right align-top tabular-nums opacity-35 dark:border-white/8">{{ line.newNumber ?? '' }}</td>
                  <td class="whitespace-pre-wrap break-all px-3 align-top {{ line.kind === 'no-newline' ? 'opacity-45 italic' : '' }}"><span class="select-none opacity-40">{{ line.kind === 'add' ? '+' : line.kind === 'delete' ? '−' : line.kind === 'no-newline' ? '\\' : ' ' }}</span> {{ line.text }}</td>
                </tr>
              @endforeach
            @endforeach
          </table>
        @endif
      </div>
    @endforeach
  @endif
</div>
