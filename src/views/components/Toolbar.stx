<script server>
// GitHub Desktop's chrome — four controls naming what you are working in —
// wearing Dia's clothes: it sits directly on the tinted window rather than in
// a bar of its own, so there is no divider under it and no fill behind it.
export const items = $props.items || []
</script>

<!--
  `data-drag` marks the region the window moves by. With the titlebar hidden
  there is no system bar to grab, so the app has to nominate its own drag
  surface — and every control inside it opts back out with `data-no-drag`, or
  a click on a dropdown would start a window drag instead of opening it.

  Fixed height and `shrink-0`, not `flex-1`: in a column flex container a
  `flex-1` header grows to take half the window.
-->
<header data-drag class="flex h-[46px] shrink-0 items-stretch gap-[3px] pb-[8px] pl-[6px] pr-[10px] pt-[2px]">
  @foreach (items as item)
    <!--
      Sized to its content rather than stretched to a quarter of the window.
      Four equal columns across a 1400px window leave each control mostly empty
      and push the last one to the far corner, which reads as a toolbar that
      failed to lay out rather than as one designed at that width. `fetch` is
      the exception: it is the only control that is a verb, so it takes the
      trailing edge.
    -->
    <button
      type="button"
      data-no-drag
      data-toolbar="{{ item.id }}"
      class="group flex min-w-0 max-w-[290px] shrink items-center gap-[8px] rounded-[9px] px-[9px] text-left transition-colors duration-150 hover:bg-white/45 active:bg-white/65 dark:hover:bg-white/10 dark:active:bg-white/[0.16] {{ item.id === 'fetch' ? 'ml-auto' : '' }}"
    >
      <!--
        The icon sits in a translucent tile rather than bare on the panel. On a
        saturated space a bare glyph loses its silhouette against the tint; the
        tile gives it a constant ground whatever colour is behind it.
      -->
      <span class="grid h-[26px] w-[26px] shrink-0 place-items-center rounded-[7px] bg-white/50 shadow-[0_0.5px_1.5px_rgba(0,0,0,0.08)] dark:bg-white/10">
        <span class="{{ item.icon }} h-[14px] w-[14px] opacity-70"></span>
      </span>

      <span class="flex min-w-0 flex-col leading-none">
        <span class="truncate pb-[3px] text-[9.5px] font-semibold uppercase tracking-[0.07em] opacity-45">{{ item.label }}</span>
        <span class="truncate text-[12.5px] font-semibold">{{ item.value }}</span>
      </span>

      @if (item.detail)
        <span class="ml-auto hidden shrink-0 pl-[8px] text-[10.5px] opacity-40 xl:block">{{ item.detail }}</span>
      @endif

      @if (item.menu)
        <span class="i-f7-chevron-down ml-auto h-[8px] w-[8px] shrink-0 opacity-30 transition-opacity group-hover:opacity-60"></span>
      @endif
    </button>
  @endforeach
</header>
